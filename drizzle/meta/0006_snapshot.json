      "checkConstraints": {
        "prediction_jobs_namespace": {
          "name": "prediction_jobs_namespace",
          "value": "\"prediction_jobs\".\"namespace\" IN ('official', 'research')"
        },
        "prediction_jobs_status": {
          "name": "prediction_jobs_status",
          "value": "\"prediction_jobs\".\"status\" IN ('queued', 'running', 'ready', 'failed', 'expired')"
        },
        "prediction_jobs_expiry": {
          "name": "prediction_jobs_expiry",
          "value": "\"prediction_jobs\".\"expires_at\" > \"prediction_jobs\".\"created_at\""
        },
        "prediction_jobs_fence": {
          "name": "prediction_jobs_fence",
          "value": "\"prediction_jobs\".\"fence\" >= 0"
        },
        "prediction_jobs_lease": {
          "name": "prediction_jobs_lease",
          "value": "(\"prediction_jobs\".\"status\" = 'running' AND \"prediction_jobs\".\"owner_token\" IS NOT NULL AND \"prediction_jobs\".\"lease_until\" IS NOT NULL) OR (\"prediction_jobs\".\"status\" != 'running' AND \"prediction_jobs\".\"owner_token\" IS NULL AND \"prediction_jobs\".\"lease_until\" IS NULL)"
        },
        "prediction_jobs_result": {
          "name": "prediction_jobs_result",
          "value": "(\"prediction_jobs\".\"result_object_key\" IS NULL) = (\"prediction_jobs\".\"result_hash\" IS NULL)"
        },
        "prediction_jobs_ready": {
          "name": "prediction_jobs_ready",
          "value": "\"prediction_jobs\".\"status\" != 'ready' OR (\"prediction_jobs\".\"result_object_key\" IS NOT NULL AND \"prediction_jobs\".\"completed_at\" IS NOT NULL)"
        }
      }
